ANTHROPIC_API_KEY=your_anthropic_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=paper2wiki
DAYTONA_API_KEY=your_daytona_api_key_here
WIKI_PATH=./wiki
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# --- Optional: route LLM calls through the LiteLLM gateway (see gateway/) ---
# Off by default. When set to "litellm", every model call goes through the proxy
# (provider forced to openai + base_url), so virtual keys / budgets / caching apply.
# PAPER2WIKI_LLM_GATEWAY=litellm
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=sk-your-virtual-key      # a per-tenant virtual key from the seed script
# LITELLM_CACHE_NAMESPACE=tenant-1         # scopes semantic-cache hits to this tenant

# --- Optional: Slack front-end, only needed by `paper2wiki serve` (Loop 3) ---
# Every other command (repl / chat / sessions / config) works without these.
# Workspace-scoped and per-user: create your own Slack app — see README.md ("Slack")
# walks through it. The two tokens come from two different pages, which is the
# usual thing to get wrong.
# SLACK_BOT_TOKEN=xoxb-...     # OAuth & Permissions page (after installing)
# SLACK_APP_TOKEN=xapp-...     # Basic Information → App-Level Tokens
# SLACK_CHANNEL_ID=C0123ABCDEF # the one channel the bot listens to
