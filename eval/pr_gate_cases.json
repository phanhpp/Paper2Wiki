[
  {
    "id": "web_extract_empty_urls",
    "type": "regression",
    "category": "boundary",
    "tool": "web_extract",
    "inputs": {
      "urls": []
    },
    "expect_empty": true,
    "_note": "Empty URL list returns [] immediately before any provider call. No API key needed."
  },
  {
    "id": "web_extract_localhost_blocked",
    "type": "regression",
    "category": "boundary",
    "tool": "web_extract",
    "inputs": {
      "urls": [
        "http://localhost/secret"
      ]
    },
    "expect_keys": [
      "blocked"
    ],
    "_note": "SSRF check runs before any provider call. Returns ExtractResult(error='Blocked: ...') \u2014 'blocked' appears in JSON output. No API key needed."
  },
  {
    "id": "web_extract_private_ip_blocked",
    "type": "regression",
    "category": "boundary",
    "tool": "web_extract",
    "inputs": {
      "urls": [
        "http://192.168.1.1"
      ]
    },
    "expect_keys": [
      "blocked"
    ],
    "_note": "Private IP range blocked by SSRF filter before any provider call. No API key needed."
  },
  {
    "id": "web_extract_metadata_ip_blocked",
    "type": "regression",
    "category": "boundary",
    "tool": "web_extract",
    "inputs": {
      "urls": [
        "http://169.254.169.254/latest/meta-data/"
      ]
    },
    "expect_keys": [
      "blocked"
    ],
    "_note": "SSRF: cloud-metadata endpoint (link-local 169.254.x) \u2014 the classic attack target. Blocked before any provider call. No API key needed."
  },
  {
    "id": "sha256_basic",
    "type": "regression",
    "category": "hashing",
    "tool": "compute_sha256",
    "inputs": {
      "text": "hello world"
    },
    "expect_value": [
      "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9"
    ],
    "_note": "Pure deterministic digest. Exact SHA-256 of 'hello world'."
  },
  {
    "id": "sha256_strips_leading_newlines",
    "type": "regression",
    "category": "hashing",
    "tool": "compute_sha256",
    "inputs": {
      "text": "\n\nhello world"
    },
    "expect_value": [
      "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9"
    ],
    "_note": "Wiki raw-source convention: lstrip('\\n') is on by default, so leading newlines are stripped \u2192 SAME hash as 'hello world'. Guards the hash convention used for raw/ integrity."
  },
  {
    "id": "fetch_arxiv_valid_id",
    "type": "capability",
    "category": "retrieval",
    "tool": "fetch_arxiv",
    "inputs": {
      "query": "1706.03762"
    },
    "expect_keys_or": [
      [
        "title",
        "pdf_path",
        "authors"
      ],
      [
        "rate_limited"
      ]
    ],
    "_note": "Capability (network, non-blocking) \u2014 passes on paper result or graceful rate_limited. arXiv direct, no provider key."
  },
  {
    "id": "web_search_returns_results",
    "type": "capability",
    "category": "retrieval",
    "tool": "web_search",
    "inputs": {
      "query": "transformer architecture deep learning"
    },
    "expect_keys": [
      "title",
      "url"
    ],
    "requires_web_provider": true,
    "_note": "Capability (network, non-blocking) \u2014 needs FIRECRAWL/TAVILY/EXA key; skipped if none set."
  },
  {
    "id": "web_extract_arxiv_html",
    "type": "capability",
    "category": "retrieval",
    "tool": "web_extract",
    "inputs": {
      "urls": [
        "https://arxiv.org/html/1706.03762"
      ],
      "use_summarizer": false
    },
    "expect_keys": [
      "content",
      "url"
    ],
    "requires_web_provider": true,
    "_note": "Capability (network, non-blocking) \u2014 content quality varies by provider. use_summarizer=false avoids LLM cost. Skipped if no provider key."
  }
]
