[
  {
    "id": "wiki_check_runs",
    "type": "regression",
    "category": "health",
    "tool": "quick_wiki_integrity_check",
    "inputs": {},
    "expect_keys": ["wiki-check"],
    "_note": "Run wiki check on commited wiki/ and return 'wiki-check: OK'."
  },
  {
    "id": "web_extract_empty_urls",
    "type": "regression",
    "category": "boundary",
    "tool": "web_extract",
    "inputs": {"urls": []},
    "expect_empty": true,
    "_note": "Empty URL list returns [] immediately before any provider call. No API key needed."
  },
  {
    "id": "web_extract_localhost_blocked",
    "type": "regression",
    "category": "boundary",
    "tool": "web_extract",
    "inputs": {"urls": ["http://localhost/secret"]},
    "expect_keys": ["blocked"],
    "_note": "SSRF check runs before any provider call. Returns ExtractResult(error='Blocked: ...') — 'blocked' appears in JSON output. No API key needed."
  },
  {
    "id": "web_extract_private_ip_blocked",
    "type": "regression",
    "category": "boundary",
    "tool": "web_extract",
    "inputs": {"urls": ["http://192.168.1.1"]},
    "expect_keys": ["blocked"],
    "_note": "Private IP range blocked by SSRF filter before any provider call. No API key needed."
  },
  {
    "id": "fetch_arxiv_valid_id",
    "type": "regression",
    "category": "retrieval",
    "tool": "fetch_arxiv",
    "inputs": {"query": "1706.03762"},
    "expect_keys_or": [["title", "pdf_path", "authors"], ["rate_limited"]],
    "_note": "Passes on paper result or graceful rate_limited response. Tests both happy path and 429 handling."
  },
  {
    "id": "web_search_returns_results",
    "type": "regression",
    "category": "retrieval",
    "tool": "web_search",
    "inputs": {"query": "transformer architecture deep learning"},
    "expect_keys": ["title", "url"],
    "requires_web_provider": true,
    "_note": "Needs at least one of FIRECRAWL_API_KEY, TAVILY_API_KEY, EXA_API_KEY. Skipped in CI if none set."
  },
  {
    "id": "web_extract_arxiv_html",
    "type": "capability",
    "category": "retrieval",
    "tool": "web_extract",
    "inputs": {"urls": ["https://arxiv.org/html/1706.03762"], "use_summarizer": false},
    "expect_keys": ["content", "url"],
    "requires_web_provider": true,
    "_note": "Capability — content quality varies by provider. use_summarizer=false avoids LLM cost. Skipped in CI if no provider key set."
  },
  {
    "id": "fetch_arxiv_old_id",
    "type": "capability",
    "category": "retrieval",
    "tool": "fetch_arxiv",
    "inputs": {"query": "math/0211159"},
    "expect_keys_or": [["title", "authors"], ["rate_limited"]],
    "_note": "Capability — old pre-2007 arXiv ID format (category/number). Key-free (arXiv direct). Passes on result or graceful 429."
  },
  {
    "id": "fetch_arxiv_versioned",
    "type": "capability",
    "category": "retrieval",
    "tool": "fetch_arxiv",
    "inputs": {"query": "2103.00020v1"},
    "expect_keys_or": [["title"], ["rate_limited"]],
    "_note": "Capability — explicit version suffix (v1). Key-free (arXiv direct). Passes on result or graceful 429."
  }
]
