*.log

# Local config (committed: config.example.yaml)
*.yaml
!config.example.yaml
prompt.yaml

# Runtime / sessions
.sessions/

# Eval — ephemeral (CI generates eval/results.json at runtime)
eval/results.json
# Eval — versioned (tracked; required by CI: run_gate.py, push_golden_datasets.py)
#   eval/pr_gate_cases.json
#   eval/golden_datasets/*.json
#   eval/cached_outputs/*.json

# Tests — local fixtures & LangSmith replay cache (CI: LANGSMITH_TEST_CACHE)
tests/fixtures/
tests/cassettes/

# Agent memory — session notes may reference sensitive info
memories/*
!memories/AGENTS.md
!memories/trace_analysis_log.md
!memories/baselines.json
USER.md

# Wiki — local/generated (wiki pages themselves are tracked)
wiki/raw/assets/
wiki/raw/papers/graphrag-query-focused-summarization.md
wiki/.cache/
wiki/graph/

# Observability dev artifacts
src/tools/observability_eval_tools/trace_offloads/
large_tool_results/

# Project-local scratch & deprecated
notebooks/
.aws/
skills/deprecated/
marp-slides/
web_tools_reference/
eval_guide/
project_overview.md
notes.md
test.md
requirements.txt
src/agents/prompt_builder.py
memories/agents_md_template.md
docs/
prometheus/master_key

# gateway secrets (never commit)
gateway/.env
gateway/prometheus/master_key

# connector raw dumps — large, and eventually personal (gmail, slack).
# Leading slash matters: a bare `connectors/` would also ignore src/connectors/
# and tests/connectors/, silently excluding the code itself.
/connectors/
